// Dual Kawase upsample -- compute variant of dual_kawase_upsample.frag.
//
// Identical kernel to the fragment version: four cardinal taps at double
// half-texel offsets with weight 1, four diagonal taps with weight 2, divided by
// the total weight of 12. Keeping the weights in step matters -- a mismatch
// would make blur look different depending on which path a given GPU took.
//
// See dual_kawase_downsample.comp for why this writes through imageStore.
//
// Requires GLES 3.1.

#version 310 es

precision highp float;

layout(local_size_x = 8, local_size_y = 8) in;

uniform sampler2D tex;
layout(rgba8, binding = 0) writeonly uniform highp image2D dst;

// 0.5 / source_size. The source is half the destination here, so these steps are
// large in destination terms -- that spread is what accumulates the blur.
uniform vec2 half_texel;
uniform float offset;
uniform ivec2 dst_size;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= dst_size.x || coord.y >= dst_size.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(dst_size);

    vec4 sum = vec4(0.0);

    sum += texture(tex, uv + vec2(-half_texel.x * 2.0, 0.0) * offset);
    sum += texture(tex, uv + vec2(half_texel.x * 2.0, 0.0) * offset);
    sum += texture(tex, uv + vec2(0.0, half_texel.y * 2.0) * offset);
    sum += texture(tex, uv + vec2(0.0, -half_texel.y * 2.0) * offset);

    sum += texture(tex, uv + vec2(-half_texel.x, half_texel.y) * offset) * 2.0;
    sum += texture(tex, uv + vec2(half_texel.x, half_texel.y) * offset) * 2.0;
    sum += texture(tex, uv + vec2(-half_texel.x, -half_texel.y) * offset) * 2.0;
    sum += texture(tex, uv + vec2(half_texel.x, -half_texel.y) * offset) * 2.0;

    imageStore(dst, coord, sum / 12.0);
}
