// Dual Kawase downsample -- compute variant of dual_kawase_downsample.frag.
//
// Identical kernel to the fragment version (centre tap weighted 4, four
// diagonal taps at half-texel offsets, divided by 8), so both paths produce the
// same image and the fallback is not visually distinguishable.
//
// What differs is the plumbing. The fragment path has to bind the destination
// texture as a framebuffer, clear it, and draw a full-screen quad for every one
// of the 2*levels passes. Writing through imageStore skips all of that: the
// destination is bound as an image, and each invocation writes its own texel.
//
// Requires GLES 3.1. Callers must keep the fragment path for contexts that only
// grant 2.0 -- see GlesRenderer::supports_compute.

#version 310 es

precision highp float;

// One workgroup per 8x8 block of DESTINATION texels. The dispatch rounds up, so
// the last group along each axis can run partly outside the image; the bounds
// check in main() discards those invocations.
layout(local_size_x = 8, local_size_y = 8) in;

uniform sampler2D tex;
layout(rgba8, binding = 0) writeonly uniform highp image2D dst;

// 0.5 / source_size, i.e. half a source texel in UV space.
uniform vec2 half_texel;
// Blur spread multiplier (1.0 = standard, higher = stronger).
uniform float offset;
// Destination size in texels, used for the bounds check and to derive UVs.
uniform ivec2 dst_size;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= dst_size.x || coord.y >= dst_size.y) {
        return;
    }

    // Sample at the destination texel's centre expressed in source UV space.
    // Because the destination is half the source resolution, the hardware's
    // bilinear filter gives a free 2x2 average per fetch -- the same trick the
    // fragment path gets from rasterising into a half-size target.
    vec2 uv = (vec2(coord) + 0.5) / vec2(dst_size);

    vec4 sum = texture(tex, uv) * 4.0;
    sum += texture(tex, uv - half_texel * offset);
    sum += texture(tex, uv + half_texel * offset);
    sum += texture(tex, uv + vec2(half_texel.x, -half_texel.y) * offset);
    sum += texture(tex, uv + vec2(-half_texel.x, half_texel.y) * offset);

    imageStore(dst, coord, sum / 8.0);
}
