[workspace]
members = ["cosmic-display-fix", "cosmic-pip-fix"]
resolver = "2"

[workspace.dependencies]
tokio = { version = "1.38", features = ["full"] }
notify = "6.1"
regex = "1.10"
serde = { version = "1.0", features = ["derive"] }
anyhow = "1.0"
log = "0.4"
env_logger = "0.11"
zbus = "4.4"
clap = { version = "4.5", features = ["derive"] }
dirs = "5.0"
