+if command -v pkexec >/dev/null 2>&1; then
+  pkexec bash -c 'cat > /etc/profile.d/cosmic-disable-scanout.sh <<EOF2
+COSMIC_DISABLE_DIRECT_SCANOUT=1
+COSMIC_DISABLE_OVERLAY_SCANOUT=1
+EOF2
+chmod 644 /etc/profile.d/cosmic-disable-scanout.sh' 2>/dev/null || echo "pkexec skip (no sudo)"
+fi
+cat > "${SYSTEMD_USER_DIR}/cosmic-display-fix.service" <<EOF
+[Unit]
+Description=Universal Display Fix - Rust COSMIC event-driven (XDG, no hardcode)
+After=graphical-session.target
+Wants=graphical-session.target
+
+[Service]
+Type=simple
+ExecStart=${BIN_DST} --daemon
+Restart=on-failure
+RestartSec=5
+Environment=COSMIC_DISABLE_DIRECT_SCANOUT=1
+Environment=COSMIC_DISABLE_OVERLAY_SCANOUT=1
+
+[Install]
+WantedBy=default.target
+EOF
+systemctl --user daemon-reload 2>/dev/null || true
+systemctl --user enable --now cosmic-display-fix.service 2>/dev/null || true
+systemctl --user restart cosmic-display-fix.service 2>/dev/null || true
+echo "Rust display fix instalado: $BIN_DST (XDG: $ENV_DIR)"
+RUST_LOG=info "$BIN_DST" --check 2>&1 | head -20
