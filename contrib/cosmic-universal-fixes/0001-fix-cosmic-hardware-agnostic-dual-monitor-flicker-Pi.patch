+PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
+BIN_SRC="$PROJECT_DIR/target/release/cosmic-display-fix"
+BIN_DST="${HOME}/.local/bin/cosmic-display-fix-rust"
+SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"
+ENV_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/environment.d"
+mkdir -p "${HOME}/.local/bin" "${SYSTEMD_USER_DIR}" "${ENV_DIR}"
+cp "$BIN_SRC" "$BIN_DST"
+chmod +x "$BIN_DST"
+cat > "${ENV_DIR}/99-cosmic-disable-scanout.conf" <<'EOF'
+COSMIC_DISABLE_DIRECT_SCANOUT=1
+COSMIC_DISABLE_OVERLAY_SCANOUT=1
+EOF
