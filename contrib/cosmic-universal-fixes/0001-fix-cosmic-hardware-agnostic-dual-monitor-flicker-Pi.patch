+#!/bin/bash
+set -e
+# XDG-compliant, profesional, Rust COSMIC, no hardcode /home/diez
+PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
+echo "Building Rust COSMIC fixes (professional, XDG, event-driven)..."
+cargo build --release --manifest-path "$PROJECT_DIR/Cargo.toml"
+echo "Installing..."
+bash "$PROJECT_DIR/cosmic-display-fix-install.sh"
+bash "$PROJECT_DIR/cosmic-pip-fix-install.sh"
