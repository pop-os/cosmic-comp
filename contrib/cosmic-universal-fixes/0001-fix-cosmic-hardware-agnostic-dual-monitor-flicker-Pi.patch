+BIN_SRC="$PROJECT_DIR/target/release/cosmic-pip-fix"
+BIN_DST="${HOME}/.local/bin/cosmic-pip-fix-rust"
+SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"
+mkdir -p "${HOME}/.local/bin" "${SYSTEMD_USER_DIR}"
