+systemctl --user is-active cosmic-display-fix.service cosmic-pip-sticky.service || true
+echo "cosmic-randr:"
+cosmic-randr list 2>&1 | grep -E "current|Position" | head -10
+echo "Reglas PiP:"
+cat "${XDG_CONFIG_HOME:-${HOME}/.config}/cosmic/com.system76.CosmicSettings.WindowRules/v1/tiling_exception_custom" 2>&1 | head -15
+echo "Listo. Rust COSMIC event-driven activo. Reinicia para aplicar scanout disable completo a cosmic-comp."
