+"$BIN_DST" --install-rules 2>&1 | head -10
+cat > "${SYSTEMD_USER_DIR}/cosmic-pip-sticky.service" <<EOF
+[Unit]
+Description=PiP Sticky Fix - Rust COSMIC event-driven (XDG, no hardcode)
+After=graphical-session.target
+Wants=graphical-session.target
